# Template for .env.local (which is gitignored and must never be committed).
# Generate real values on the instance with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# These are the ONLY two secrets this app has. The database endpoint is
# hardcoded to http://localhost:8086 in lib/db.js on purpose: it is not
# configurable, so no env var can ever repoint this tool at another store.

JWT_SECRET=<96 hex chars>
CONFIRM_HMAC_SECRET=<96 hex chars>
